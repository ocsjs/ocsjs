# 推送前预检测：与 GitHub Actions 构建流程（pnpm tsc + frozen-lockfile）一致，
# 防止格式/ESLint/类型/锁文件错误进入远端导致 CI 失败返工。
# 这里使用只校验不写入的 lint:check（避免 hook 静默修改已提交代码）。
# 需要跳过时使用：git push --no-verify
echo "🔍 push 前预检测：锁文件一致性 + prettier + eslint + tsc ..."

# 完整日志写入临时文件后再原样打印（VSCode「Git 输出」面板可见），
# 失败时从中提取关键错误行用于原生弹窗摘要（GUI 客户端 push 无终端提示）
# 注：不用管道+PIPESTATUS（dash 等 POSIX sh 不支持），改为先落盘再打印
CHECK_LOG=$(mktemp)
# 先校验锁文件与 package.json 一致（CI frozen-lockfile 的本地预演，--lockfile-only 不动 node_modules），
# 通过后再跑代码检查，任一失败即短路
{
	pnpm install --frozen-lockfile --lockfile-only && pnpm check
} >"$CHECK_LOG" 2>&1
CHECK_CODE=$?
cat "$CHECK_LOG"

if [ "$CHECK_CODE" -ne 0 ]; then
	# 提取关键错误行作为摘要：prettier 的 [warn]、eslint/tsc 的 error、pnpm 锁文件错误
	SUMMARY=$(grep -E '\[warn\]|error|ERR_PNPM|mismatched|Code style issues' "$CHECK_LOG" | head -15)
	rm -f "$CHECK_LOG"

	echo ""
	echo "❌ push 已被 pre-push 拦截，请根据上方日志修复后重试。"
	echo "   确认代码无误可用 git push --no-verify 跳过预检测。"

	node ./scripts/git-hook-notify.js \
		"push 已被 pre-push 拦截" \
		"push 前预检测失败（锁文件一致性 / prettier / eslint / tsc），请修复后重试：

$SUMMARY

完整日志见 VSCode「Git 输出」面板或终端。
确认代码无误可用 git push --no-verify 跳过。" || true

	exit "$CHECK_CODE"
fi

rm -f "$CHECK_LOG"
